I’ll add F11 fullscreen toggle for you.
When you press F11, it will switch between fullscreen and windowed (resizable) while keeping the smooth scaling system.

Here’s the updated code with fullscreen toggle:

import pygame
import random
import os

# Initialize Pygame
pygame.init()

# Colors
white = (255, 255, 255)
yellow = (255, 255, 102)
black = (0, 0, 0)
red = (213, 50, 80)
green = (0, 255, 0)
blue = (50, 153, 213)

# --- Base grid size (locked for smoothness) ---
base_block = 20  

# Default window size (can be resized later)
dis_width = 600
dis_height = 400

# Initialize display (RESIZABLE)
dis = pygame.display.set_mode((dis_width, dis_height), pygame.RESIZABLE)
pygame.display.set_caption('Snake Game Enhanced')

clock = pygame.time.Clock()
snake_speed = 15

fullscreen = False  # fullscreen toggle state

# Fonts
def make_fonts(scale=1):
    return {
        "small": pygame.font.SysFont("bahnschrift", int(20*scale)),
        "score": pygame.font.SysFont("comicsansms", int(18*scale)),
        "title": pygame.font.SysFont("comicsansms", int(28*scale), bold=True)
    }

fonts = make_fonts()

# --- High Score Management ---
def load_high_score():
    if os.path.exists("highscore.txt"):
        with open("highscore.txt", "r") as f:
            try:
                return int(f.read())
            except:
                return 0
    return 0

def save_high_score(score):
    with open("highscore.txt", "w") as f:
        f.write(str(score))

high_score = load_high_score()

def Your_score(score, high_score):
    value = fonts["score"].render(f"Score: {score}  High Score: {high_score}", True, yellow)
    dis.blit(value, [5, 5])

def our_snake(snake_list, scale):
    for i, x in enumerate(snake_list):
        size = int(base_block * scale)
        if i == len(snake_list) - 1:
            pygame.draw.rect(dis, red, [x[0]*scale, x[1]*scale, size, size])  # Head
        else:
            pygame.draw.rect(dis, black, [x[0]*scale, x[1]*scale, size, size])

def message(msg, color, y_offset=0, center=True, big=False):
    font_used = fonts["title"] if big else fonts["small"]
    mesg = font_used.render(msg, True, color)
    if center:
        dis.blit(mesg, [dis_width / 2 - mesg.get_width() / 2, dis_height / 3 + y_offset])
    else:
        dis.blit(mesg, [dis_width / 8, dis_height / 3 + y_offset])

def spawn_food(snake_List, scale):
    cols = dis_width // (base_block*scale)
    rows = dis_height // (base_block*scale)
    while True:
        foodx = random.randint(0, cols-1) * base_block
        foody = random.randint(0, rows-1) * base_block
        if [foodx, foody] not in snake_List:
            return foodx, foody

def start_screen():
    global high_score
    start = True
    while start:
        dis.fill(blue)
        message("🐍 Snake Game 🐍", yellow, -40, center=True, big=True)
        message(f"High Score: {high_score}", white, 10, center=True)
        message("Press C to Play or Q to Quit", red, 50, center=True)
        message("Press F11 to Toggle Fullscreen", white, 90, center=True)
        pygame.display.update()

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                quit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_c:
                    start = False
                if event.key == pygame.K_q:
                    pygame.quit()
                    quit()
                if event.key == pygame.K_F11:
                    toggle_fullscreen()
            if event.type == pygame.VIDEORESIZE:
                resize_screen(event.w, event.h)

def resize_screen(new_w, new_h):
    global dis, dis_width, dis_height, fonts
    dis_width, dis_height = new_w, new_h
    dis = pygame.display.set_mode((dis_width, dis_height), pygame.RESIZABLE)
    scale = dis_width / 600  # scale relative to base 600 width
    fonts = make_fonts(scale)

def toggle_fullscreen():
    global fullscreen, dis, dis_width, dis_height, fonts
    fullscreen = not fullscreen
    if fullscreen:
        dis = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
        dis_width, dis_height = dis.get_size()
    else:
        dis = pygame.display.set_mode((600, 400), pygame.RESIZABLE)
        dis_width, dis_height = 600, 400
    scale = dis_width / 600
    fonts = make_fonts(scale)

def gameLoop():
    global high_score

    game_over = False
    game_close = False
    paused = False

    x1 = dis_width // (2* (dis_width//600))
    y1 = dis_height // (2* (dis_height//600))

    x1_change = 0
    y1_change = 0

    snake_List = []
    Length_of_snake = 1

    scale = dis_width / 600  # scale factor

    foodx, foody = spawn_food(snake_List, scale)
    new_high = False  

    while not game_over:

        while game_close:
            dis.fill(blue)
            message("You Lost!", red, -50, center=True, big=True)
            if new_high:
                message("🎉 New High Score! 🎉", yellow, -10, center=True, big=True)
            else:
                message("Better luck next time!", white, -10, center=True)
            message("Press C-Play Again or Q-Quit", red, 40, center=True)
            message("Press F11 to Toggle Fullscreen", white, 80, center=True)
            Your_score(Length_of_snake - 1, high_score)
            pygame.display.update()

            for event in pygame.event.get():
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_q:
                        game_over = True
                        game_close = False
                    if event.key == pygame.K_c:
                        gameLoop()
                        return  
                    if event.key == pygame.K_F11:
                        toggle_fullscreen()
                        scale = dis_width / 600
                if event.type == pygame.VIDEORESIZE:
                    resize_screen(event.w, event.h)
                    scale = dis_width / 600

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                game_over = True
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_LEFT and x1_change == 0:
                    x1_change = -base_block
                    y1_change = 0
                elif event.key == pygame.K_RIGHT and x1_change == 0:
                    x1_change = base_block
                    y1_change = 0
                elif event.key == pygame.K_UP and y1_change == 0:
                    y1_change = -base_block
                    x1_change = 0
                elif event.key == pygame.K_DOWN and y1_change == 0:
                    y1_change = base_block
                    x1_change = 0
                elif event.key == pygame.K_p:  
                    paused = not paused
                elif event.key == pygame.K_r:  
                    gameLoop()
                    return
                elif event.key == pygame.K_F11:
                    toggle_fullscreen()
                    scale = dis_width / 600
            if event.type == pygame.VIDEORESIZE:
                resize_screen(event.w, event.h)
                scale = dis_width / 600

        if paused:
            dis.fill(blue)
            message("Paused - Press P to Resume", yellow, 0, center=True)
            message("Press F11 to Toggle Fullscreen", white, 40, center=True)
            Your_score(Length_of_snake - 1, high_score)
            pygame.display.update()
            continue

        if x1 >= dis_width or x1 < 0 or y1 >= dis_height or y1 < 0:
            game_close = True

        x1 += x1_change
        y1 += y1_change
        dis.fill(blue)

        pygame.draw.rect(dis, green, [foodx*scale, foody*scale, base_block*scale, base_block*scale])
        snake_Head = [x1, y1]
        snake_List.append(snake_Head)
        if len(snake_List) > Length_of_snake:
            del snake_List[0]

        for x in snake_List[:-1]:
            if x == snake_Head:
                game_close = True

        our_snake(snake_List, scale)

        score_now = Length_of_snake - 1
        if score_now > high_score:
            high_score = score_now
            save_high_score(high_score)
            new_high = True  

        Your_score(score_now, high_score)
        pygame.display.update()

        if x1 == foodx and y1 == foody:
            foodx, foody = spawn_food(snake_List, scale)
            Length_of_snake += 1

        clock.tick(snake_speed)

    pygame.quit()
    quit()

start_screen()
gameLoop()


✅ Now you can press F11 anytime (menu, paused, game over, or during play) to toggle fullscreen smoothly.
